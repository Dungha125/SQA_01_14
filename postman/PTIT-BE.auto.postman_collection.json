          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/api/subjects/upload-excel",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": "{{FULL_CT_XLSX}}"
                },
                {
                  "key": "semester",
                  "type": "text",
                  "value": "{{SEMESTER_UPLOAD}}"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const _k = \"FULL_CT_XLSX\";",
                  "const _pk = \"file\";",
                  "const pth = pm.environment.get(_k) || pm.collectionVariables.get(_k);",
                  "if (!pth) { console.warn(\"Missing path for \" + _k); return; }",
                  "if (pm.request.body && pm.request.body.mode === \"formdata\" && pm.request.body.formdata) {",
                  "    const fd = pm.request.body.formdata;",
                  "    fd.remove(_pk);",
                  "    fd.append({ key: _pk, type: \"file\", src: pth });",
                  "}"
                ]
              }
            }
          ]
        },
